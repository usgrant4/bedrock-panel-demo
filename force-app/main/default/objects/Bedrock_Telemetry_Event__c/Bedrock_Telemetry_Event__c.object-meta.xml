<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <deploymentStatus>Deployed</deploymentStatus>
    <description>A fault event from Bedrock Connect. In production this is a Data Cloud DLO fed by Kinesis.</description>
    <enableActivities>true</enableActivities>
    <enableHistory>false</enableHistory>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <label>Bedrock Telemetry Event</label>
    <nameField>
    <displayFormat>BTE-{00000}</displayFormat>
    <label>Event Number</label>
    <type>AutoNumber</type>
</nameField>
    <pluralLabel>Bedrock Telemetry Events</pluralLabel>
    <sharingModel>ReadWrite</sharingModel>
</CustomObject>
