<?xml version="1.0" encoding="UTF-8"?>
<ConnectedApp xmlns="http://soap.sforce.com/2006/04/metadata">
    <contactEmail>ugrantiv@gmail.com</contactEmail>
    <label>Bedrock Dashboard OAuth</label>
    <description>OAuth Connected App used by the Vercel-hosted Bedrock Build Dashboard to query recent service cases and warranty claims via refresh-token grant.</description>
    <oauthConfig>
        <callbackUrl>https://bedrock-dashboard-sand.vercel.app/api/oauth-callback</callbackUrl>
        <isAdminApproved>false</isAdminApproved>
        <isConsumerSecretOptional>false</isConsumerSecretOptional>
        <scopes>Api</scopes>
        <scopes>RefreshToken</scopes>
        <scopes>Web</scopes>
    </oauthConfig>
</ConnectedApp>
